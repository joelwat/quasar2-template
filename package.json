{
    "name": "quasar2-template",
    "version": "0.0.1",
    "description": "Quasar v2 Template",
    "productName": "Quasar v2 Template",
    "author": "Joel Watson <joelwat@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "quasar build",
        "dev": "quasar dev",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "postinstall": "quasar prepare",
        "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
        "test:component": "cross-env NODE_ENV=test cypress open --component",
        "test:component:ci": "cross-env NODE_ENV=test cypress run --component",
        "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://localhost:3000 \"cypress open --e2e\"",
        "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://localhost:3000 \"cypress run --e2e\"",
        "test:unit": "vitest",
        "test:unit:ci": "vitest run",
        "test:unit:ui": "vitest --ui",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@quasar/extras": "^2.1.0",
        "axios": "^1.20.0",
        "pinia": "^4.1.0",
        "quasar": "^2.35.2",
        "unplugin-vue-router": "^0.19.2",
        "vite-plugin-vue-layouts": "^0.11.0",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.16",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@cypress/code-coverage": "^4.0.3",
        "@eslint/js": "^10.0.1",
        "@intlify/unplugin-vue-i18n": "^11.2.7",
        "@quasar/app-vite": "3.10.3",
        "@quasar/quasar-app-extension-testing-e2e-cypress": "^7.0.0",
        "@quasar/quasar-app-extension-testing-unit-vitest": "3.0.0",
        "@quasar/vite-plugin": "^2.0.2",
        "@types/node": "^24.19.2",
        "@unocss/preset-uno": "^66.11.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/ui": "^5.0.5",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "autoprefixer": "^10.6.1",
        "cross-env": "^10.1.0",
        "cypress": "^15.21.1",
        "eslint": "^10.13.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-cypress": "^7.0.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.11.1",
        "jiti": "^2.7.0",
        "rollup-plugin-visualizer": "^7.1.1",
        "sass": "^1.105.2",
        "start-server-and-test": "^3.0.13",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "unocss": "^66.11.0",
        "vite": "^8.3.0",
        "vite-plugin-checker": "^0.14.5",
        "vite-plugin-inspect": "^12.1.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "engines": {
        "node": "^24",
        "npm": ">= 6.13.4",
        "yarn": ">= 1.21.1"
    },
    "packageManager": "yarn@4.18.1"
}
