{
    "name": "quasar2-template",
    "version": "0.0.1",
    "description": "Quasar v2 Template",
    "productName": "Quasar v2 Template",
    "author": "Joel Watson <joelwat@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "quasar build",
        "dev": "quasar dev",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "postinstall": "quasar prepare",
        "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
        "test:component": "cross-env NODE_ENV=test cypress open --component",
        "test:component:ci": "cross-env NODE_ENV=test cypress run --component",
        "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress open --e2e\"",
        "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress run --e2e\"",
        "test:unit": "vitest",
        "test:unit:ci": "vitest run",
        "test:unit:ui": "vitest --ui",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@quasar/extras": "^1.17.0",
        "axios": "^1.12.2",
        "pinia": "^3.0.3",
        "quasar": "^2.18.5",
        "unplugin-vue-router": "^0.15.0",
        "vite-plugin-vue-layouts": "^0.11.0",
        "vue": "^3.5.22",
        "vue-i18n": "^11.1.12",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@cypress/code-coverage": "^3.14.6",
        "@eslint/js": "^9.37.0",
        "@intlify/unplugin-vue-i18n": "^11.0.1",
        "@quasar/app-vite": "^2.4.0",
        "@quasar/quasar-app-extension-testing-e2e-cypress": "^6.2.1",
        "@quasar/quasar-app-extension-testing-unit-vitest": "^1.2.3",
        "@quasar/vite-plugin": "^1.10.0",
        "@types/node": "^22.18.8",
        "@unocss/preset-uno": "^66.5.2",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitest/ui": "^3.2.4",
        "@vue/eslint-config-typescript": "^14.6.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.4.21",
        "cross-env": "^10.1.0",
        "cypress": "14.5.4",
        "eslint": "^9.37.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-cypress": "^5.2.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.5.0",
        "jiti": "^2.6.1",
        "rollup-plugin-visualizer": "^6.0.4",
        "sass": "^1.93.2",
        "start-server-and-test": "^2.1.2",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.0",
        "unocss": "^66.5.2",
        "vite-plugin-checker": "^0.11.0",
        "vite-plugin-inspect": "^11.3.3",
        "vitest": "^3.2.4",
        "vue-tsc": "^3.1.1"
    },
    "engines": {
        "node": "^24 || ^22",
        "npm": ">= 6.13.4",
        "yarn": ">= 1.21.1"
    },
    "packageManager": "yarn@4.10.3"
}
