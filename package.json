{
  "name": "quasar-cypress-component-tests",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Quasar App",
  "author": "Joel Watson <joelwat@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "quasar build",
    "dev": "quasar dev",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "lint:fix": "eslint --fix --ext .js,.ts,.vue ./",
    "postinstall": "quasar prepare",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:component": "cross-env NODE_ENV=test cypress open --component",
    "test:component:ci": "cross-env NODE_ENV=test cypress run --component",
    "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress open --e2e\"",
    "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress run --e2e\"",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:ui": "vitest --ui"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.13",
    "axios": "^1.7.7",
    "pinia": "^2.2.4",
    "quasar": "^2.17.6",
    "unplugin-vue-router": "^0.10.8",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.13.10",
    "@intlify/unplugin-vue-i18n": "^5.2.0",
    "@quasar/app-vite": "^2.0.5",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "^6.1.0",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^1.1.0",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitest/ui": "^2.1.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "cypress": "^13.16.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-cypress": "^4.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.29.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "start-server-and-test": "^2.0.8",
    "typescript": "~5.7.2",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-inspect": "^0.8.7",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": "^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "packageManager": "yarn@4.6.0"
}
