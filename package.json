{
    "name": "quasar2-template",
    "version": "0.0.1",
    "description": "Quasar v2 Template",
    "productName": "Quasar v2 Template",
    "author": "Joel Watson <joelwat@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "quasar build",
        "dev": "quasar dev",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "postinstall": "quasar prepare",
        "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
        "test:component": "cross-env NODE_ENV=test cypress open --component",
        "test:component:ci": "cross-env NODE_ENV=test cypress run --component",
        "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress open --e2e\"",
        "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress run --e2e\"",
        "test:unit": "vitest",
        "test:unit:ci": "vitest run",
        "test:unit:ui": "vitest --ui",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@quasar/extras": "^1.16.17",
        "axios": "^1.8.4",
        "pinia": "^3.0.2",
        "quasar": "^2.18.1",
        "unplugin-vue-router": "^0.12.0",
        "vite-plugin-vue-layouts": "^0.11.0",
        "vue": "^3.5.13",
        "vue-i18n": "^11.1.3",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@cypress/code-coverage": "^3.14.0",
        "@eslint/js": "^9.25.1",
        "@intlify/unplugin-vue-i18n": "^6.0.8",
        "@quasar/app-vite": "^2.2.0",
        "@quasar/quasar-app-extension-testing-e2e-cypress": "^6.1.0",
        "@quasar/quasar-app-extension-testing-unit-vitest": "^1.1.0",
        "@types/node": "^22.14.1",
        "@unocss/preset-uno": "^66.1.0-beta.12",
        "@vitest/ui": "^3.1.2",
        "@vue/eslint-config-typescript": "^14.5.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.4.21",
        "cross-env": "^7.0.3",
        "cypress": "^14.3.2",
        "eslint": "^9.25.1",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-cypress": "^4.3.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-vue": "^10.0.0",
        "jiti": "^2.4.2",
        "rollup-plugin-visualizer": "^5.14.0",
        "start-server-and-test": "^2.0.11",
        "tslib": "^2.8.1",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.31.0",
        "unocss": "^66.1.0-beta.12",
        "vite-plugin-checker": "^0.9.1",
        "vite-plugin-inspect": "^11.0.1",
        "vitest": "^3.1.2",
        "vue-tsc": "^2.2.10"
    },
    "engines": {
        "node": "^24 || ^22 || ^20 || ^18",
        "npm": ">= 6.13.4",
        "yarn": ">= 1.21.1"
    },
    "packageManager": "yarn@4.9.1"
}
