{
  "name": "quasar2-template",
  "version": "0.0.1",
  "description": "Quasar v2 Template",
  "productName": "Quasar v2 Template",
  "author": "Joel Watson <joelwat@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "quasar build",
    "dev": "quasar dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "quasar prepare",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:component": "cross-env NODE_ENV=test cypress open --component",
    "test:component:ci": "cross-env NODE_ENV=test cypress run --component",
    "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress open --e2e\"",
    "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:3000 \"cypress run --e2e\"",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:ui": "vitest --ui",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "axios": "^1.15.2",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "unplugin-vue-router": "^0.19.2",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.1.2",
    "@quasar/app-vite": "2.3.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "^6.2.1",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^1.2.4",
    "@quasar/vite-plugin": "^1.11.0",
    "@types/node": "^24.12.2",
    "@unocss/preset-uno": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/ui": "^4.1.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "cypress": "15.17.0",
    "eslint": "^10.2.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-cypress": "^6.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.0",
    "jiti": "^2.6.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.99.0",
    "start-server-and-test": "^3.0.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1",
    "unocss": "^66.6.8",
    "vite-plugin-checker": "^0.14.0",
    "vite-plugin-inspect": "^11.3.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": "^24 || ^22",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "packageManager": "yarn@4.17.0"
}
